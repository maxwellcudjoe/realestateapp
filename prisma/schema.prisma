generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.NVarChar(255)
  passwordHash    String    @db.NVarChar(100)
  role            String    @default("investor") @db.NVarChar(20)
  emailVerifiedAt DateTime?
  totpSecret      String?   @db.NVarChar(255)
  totpEnabledAt   DateTime?
  deletedAt       DateTime?
  // Task 7.4 — subscription tier (FREE | PREMIUM); drives 48h deal-preview gate + admin priority
  tier            String    @default("FREE") @db.NVarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  investorProfile          InvestorProfile?
  statusChanges            StatusHistory[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  loginAttempts            LoginAttempt[]
  recoveryCodes            RecoveryCode[]
  sentMessages             Message[]            @relation("UserSentMessages")
  postedDeals              Deal[]               @relation("AdminPostedDeals")
  ledDeals                 Deal[]               @relation("DealLeads")
  invoices                 Invoice[]
  subscription             Subscription?
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @db.NVarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String   @db.NVarChar(255)
  ipAddress String   @db.NVarChar(64)
  success   Boolean
  reason    String?  @db.NVarChar(50)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.NVarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @db.NVarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model InvestorProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName           String    @db.NVarChar(100)
  lastName            String    @db.NVarChar(100)
  phone               String    @db.NVarChar(50)
  addressLine1        String    @db.NVarChar(255)
  city                String    @db.NVarChar(100)
  postcode            String    @db.NVarChar(20)
  budgetMin           Decimal   @db.Decimal(12, 2)
  budgetMax           Decimal   @db.Decimal(12, 2)
  strategy            String    @db.NVarChar(20)
  buyerType           String    @db.NVarChar(20)
  targetAreas         String    @db.NVarChar(Max)   // Legacy free-text — preserved for now; structured rows live in TargetArea
  marketingConsentAt  DateTime?

  // Compliance / AML — Task 1.4
  dateOfBirth         DateTime?
  nationality         String?   @db.NVarChar(2)
  taxResidency        String?   @db.NVarChar(2)
  niNumber            String?   @db.NVarChar(20)
  isPep               Boolean   @default(false)
  pepDetails          String?   @db.NVarChar(Max)
  sourceOfFunds       String?   @db.NVarChar(30)
  sourceOfFundsDetail String?   @db.NVarChar(Max)
  complianceCompleted Boolean   @default(false)

  // Experience & funding — Task 2.4
  experienceLevel     String?   @db.NVarChar(20)   // FIRST_TIME | OWN_1_3 | OWN_4_10 | OWN_10_PLUS
  timelineToBuy       String?   @db.NVarChar(20)   // IMMEDIATE | M_1_3 | M_3_6 | M_6_PLUS | EXPLORING
  mortgageStatus      String?   @db.NVarChar(20)   // NONE | AIP | FULL_OFFER
  mortgageLender      String?   @db.NVarChar(100)
  maxLtv              Int?
  depositAvailable    Decimal?  @db.Decimal(12, 2)
  referralSource      String?   @db.NVarChar(100)

  // Buyer entity — Task 2.3 (Ltd company / LLP / Trust support)
  entityType          String    @default("INDIVIDUAL") @db.NVarChar(20)   // INDIVIDUAL | LTD_COMPANY | LLP | TRUST
  companyName         String?   @db.NVarChar(200)
  companyNumber       String?   @db.NVarChar(20)
  vatNumber           String?   @db.NVarChar(20)
  companyAddress      String?   @db.NVarChar(500)

  // Task 6.1 — SumSub applicant id (stored once, reused for all KYC checks)
  sumsubApplicantId   String?   @db.NVarChar(64)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  application        Application?
  structuredAreas    TargetArea[]
  strategies         InvestorStrategy[]
}

model InvestorStrategy {
  id                String          @id @default(cuid())
  investorProfileId String
  investorProfile   InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  strategy          String          @db.NVarChar(30) // BTL | HMO | FLIP | COMMERCIAL | SERVICED_ACCOM
  createdAt         DateTime        @default(now())

  @@unique([investorProfileId, strategy])
  @@index([strategy])
}

model TargetArea {
  id                String          @id @default(cuid())
  investorProfileId String
  investorProfile   InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  code              String          @db.NVarChar(30) // e.g. "manchester", "london-z2", "M-postcode"
  label             String          @db.NVarChar(100)
  createdAt         DateTime        @default(now())

  @@unique([investorProfileId, code])
  @@index([code])
}

model Application {
  id                String          @id @default(cuid())
  investorProfileId String          @unique
  investorProfile   InvestorProfile @relation(fields: [investorProfileId], references: [id], onDelete: Cascade)
  status            String          @default("SUBMITTED") @db.NVarChar(30)
  adminNotes        String?         @db.NVarChar(Max)
  // Task 6.2 — KYC re-review cycle (UK MLR 2017: typically 18 months)
  kycCompletedAt    DateTime?
  kycExpiresAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  documents     Document[]
  statusHistory StatusHistory[]
  messages      Message[]
  deals         Deal[]
}

model Document {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type             String      @db.NVarChar(30)
  fileName         String      @db.NVarChar(255)
  blobPath         String      @db.NVarChar(500)
  uploadedAt       DateTime    @default(now())
  // Task 6.3 — per-doc review actions
  reviewStatus     String      @default("PENDING") @db.NVarChar(20)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?     @db.NVarChar(1000)
  // Task 6.2 — doc-level expiry (passports, POA staleness)
  expiresAt        DateTime?
}

model StatusHistory {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fromStatus      String?     @db.NVarChar(30)
  toStatus        String      @db.NVarChar(30)
  changedByUserId String?
  changedByUser   User?       @relation(fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note            String?     @db.NVarChar(Max)
  createdAt       DateTime    @default(now())
}

model Message {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderUserId  String
  senderUser    User        @relation("UserSentMessages", fields: [senderUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dealId        String?
  deal          Deal?       @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject       String      @db.NVarChar(255)
  body          String      @db.NVarChar(Max)
  createdAt     DateTime    @default(now())

  @@index([dealId, createdAt])
}

model Deal {
  id             String       @id @default(cuid())
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  postedByUserId String
  postedByUser   User         @relation("AdminPostedDeals", fields: [postedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title          String       @db.NVarChar(255)
  address        String       @db.NVarChar(255)
  askingPrice    Decimal      @db.Decimal(12, 2)
  summary        String?      @db.NVarChar(Max)
  status         String       @default("OPEN") @db.NVarChar(20)
  createdAt      DateTime     @default(now())

  // Task 4.3 — Richer deal cards (structured property data)
  bedrooms                Int?
  bathrooms               Int?
  propertyType            String?  @db.NVarChar(30)
  tenure                  String?  @db.NVarChar(20)
  epcRating               String?  @db.NVarChar(2)
  rentalAppraisalMonthly  Decimal? @db.Decimal(10, 2)
  floorAreaSqft           Int?
  areaCode                String?  @db.NVarChar(30)
  strategyTag             String?  @db.NVarChar(30)

  // Task 3.1 — transaction pipeline
  stage          String       @default("PROPOSED") @db.NVarChar(30)
  stageHistory   DealStageHistory[]

  // Task 3.7 — deal team handoff
  dealLeadUserId    String?
  dealLeadUser      User?     @relation("DealLeads", fields: [dealLeadUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitorContact  String?   @db.NVarChar(500)
  brokerContact     String?   @db.NVarChar(500)

  // Task 7.4 — visible to FREE tier only when publishedAt is older than 48h; PREMIUM sees as soon as set
  publishedAt    DateTime?

  response       DealResponse?
  offer          Offer?
  messages       Message[]
  documents      DealDocument[]
  viewings       Viewing[]
  favourites     DealFavourite[]
  invoices       Invoice[]
}

model DealFavourite {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([dealId, userId])
  @@index([userId, createdAt])
}

/// Task 4.1 — "Save this deal" from public Contentful pages.
model ContentfulDealInterest {
  id                 String   @id @default(cuid())
  userId             String
  contentfulEntryId  String   @db.NVarChar(64)
  title              String?  @db.NVarChar(255)
  slug               String?  @db.NVarChar(255)
  note               String?  @db.NVarChar(1000)
  createdAt          DateTime @default(now())

  @@unique([userId, contentfulEntryId])
  @@index([contentfulEntryId])
}

model Viewing {
  id               String    @id @default(cuid())
  dealId           String
  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  investorUserId   String
  requestedSlot    DateTime
  alternativeSlot  DateTime?
  confirmedSlot    DateTime?
  status           String    @default("REQUESTED") @db.NVarChar(20)  // REQUESTED | CONFIRMED | DECLINED | COMPLETED | CANCELLED
  investorNote     String?   @db.NVarChar(1000)
  adminNote        String?   @db.NVarChar(1000)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dealId, status])
}

model DealDocument {
  id               String   @id @default(cuid())
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  type             String   @db.NVarChar(40)
  fileName         String   @db.NVarChar(255)
  blobPath         String   @db.NVarChar(500)
  visibility       String   @default("INVESTOR") @db.NVarChar(20)
  uploadedAt       DateTime @default(now())

  @@index([dealId, uploadedAt])
}

model DealStageHistory {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage       String?  @db.NVarChar(30)
  toStage         String   @db.NVarChar(30)
  changedByUserId String?
  note            String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())

  @@index([dealId, createdAt])
}

model Offer {
  id                 String   @id @default(cuid())
  dealId             String   @unique
  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount             Decimal  @db.Decimal(12, 2)
  depositPercent     Int
  financingSource    String   @db.NVarChar(20)  // CASH | MORTGAGE | MIXED
  targetExchangeDate DateTime?
  conditions         String?  @db.NVarChar(Max) // free text — bullet conditions
  status             String   @default("PENDING") @db.NVarChar(20)  // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  vendorDecisionNote String?  @db.NVarChar(Max)
  submittedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DealResponse {
  id        String   @id @default(cuid())
  dealId    String   @unique
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  intent    String   @db.NVarChar(30)
  comment   String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Task 5.1 — Portfolio. Auto-created when a Deal hits COMPLETED.
model Property {
  id                       String              @id @default(cuid())
  userId                   String
  dealId                   String?             @unique
  address                  String              @db.NVarChar(255)
  purchasePrice            Decimal             @db.Decimal(12, 2)
  completionDate           DateTime
  propertyType             String?             @db.NVarChar(30)
  bedrooms                 Int?
  bathrooms                Int?
  currentValueEstimate     Decimal?            @db.Decimal(12, 2)
  currentValueUpdatedAt    DateTime?
  tenancyStatus            String              @default("VACANT") @db.NVarChar(20)
  monthlyRent              Decimal?            @db.Decimal(10, 2)
  tenancyStart             DateTime?
  tenancyEnd               DateTime?
  notes                    String?             @db.NVarChar(Max)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  documents                PropertyDocument[]

  @@index([userId, completionDate])
}

/// Task 5.2 — Per-property document archive (title deeds, EPC, gas safety, EICR, tenancy, etc.).
model PropertyDocument {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  type             String   @db.NVarChar(40)
  fileName         String   @db.NVarChar(255)
  blobPath         String   @db.NVarChar(500)
  expiresAt        DateTime?
  uploadedAt       DateTime @default(now())

  @@index([propertyId, uploadedAt])
}

/// Task 6.7 — Audit log. Records privileged actions for compliance review.
model AuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorRole     String?  @db.NVarChar(20)
  action        String   @db.NVarChar(60)
  resourceType  String   @db.NVarChar(40)
  resourceId    String?  @db.NVarChar(64)
  metadata      String?  @db.NVarChar(Max)
  ipAddress     String?  @db.NVarChar(64)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

/// Task 6.4 — Notifications centre.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String    @db.NVarChar(40)
  title       String    @db.NVarChar(255)
  body        String    @db.NVarChar(Max)
  link        String?   @db.NVarChar(500)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Task 7.3 — Rêve Bâtir invoicing. Three types (SOURCING | SUCCESS | SUBSCRIPTION).
/// Solicitor-only money model: invoices are issued by Rêve Bâtir to investors and
/// paid via bank transfer off-platform. Admin marks PAID with the transaction reference.
model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique @db.NVarChar(30)   // RB-YYYY-NNNN
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dealId          String?
  deal            Deal?     @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type            String    @db.NVarChar(20)            // SOURCING | SUCCESS | SUBSCRIPTION
  amount          Decimal   @db.Decimal(12, 2)
  description     String    @db.NVarChar(500)
  status          String    @default("DRAFT") @db.NVarChar(20)  // DRAFT | SENT | PAID | VOID
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  paidReference   String?   @db.NVarChar(255)           // bank ref / cheque / other
  pdfBlobPath     String?   @db.NVarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([dealId])
  @@index([status, dueAt])
}

/// Task 7.4 — Premium subscription. One per user (FREE tier has no Subscription row).
/// Renewal invoices are generated manually by admin (no cron). Cancelling sets
/// cancelledAt but the tier remains PREMIUM until nextRenewalAt passes.
model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingPeriod   String    @default("MONTHLY") @db.NVarChar(20)   // MONTHLY | ANNUAL
  amount          Decimal   @db.Decimal(10, 2)
  startedAt       DateTime
  cancelledAt     DateTime?
  nextRenewalAt   DateTime

  @@index([nextRenewalAt])
}

/// Task 6.1 — KYC provider integration scaffold. Provider-agnostic record.
model KycCheck {
  id              String    @id @default(cuid())
  applicationId   String
  provider        String    @db.NVarChar(30)
  externalCheckId String?   @db.NVarChar(128)
  status          String    @default("PENDING") @db.NVarChar(20)
  reportPdfUrl    String?   @db.NVarChar(500)
  rawResult       String?   @db.NVarChar(Max)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([applicationId, startedAt])
  @@index([externalCheckId])
}
